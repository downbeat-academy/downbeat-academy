{
	"$schema": "https://turbo.build/schema.json",
	"//": "The root package.json carries the `browserslist` key (see docs/adr/0003-browser-support-floor.md). It is not part of turbo's default hash, so without this entry a change to the support floor serves a cached dist built against the old target.",
	"globalDependencies": ["package.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:coverage": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:browser": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"storybook": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"build:storybook": {
			"dependsOn": ["^build"],
			"outputs": ["storybook-static/**"]
		}
	}
}

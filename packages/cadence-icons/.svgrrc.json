{
	"typescript": true,
	"icon": true,
	"dimensions": false,
	"titleProp": true,
	"filenameCase": "pascal",
	"prettier": true,
	"expandProps": true,
	"svgo": true,
	"replaceAttrValues": {
		"#000": "currentColor"
	},
	"svgProps": {
		"color": "{props.color}",
		"role": "{title || props['aria-label'] || props['aria-labelledby'] ? 'img' : undefined}",
		"aria-hidden": "{title || props['aria-label'] || props['aria-labelledby'] ? undefined : true}"
	}
}
